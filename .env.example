# ==============================================================================
# POS IPAY - PRODUCTION CONFIGURATION ENVIRONMENT VARIABLES
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=3001

# JSON Web Token Secret (Wajib diisi string acak minimal 32 karakter untuk produksi)
JWT_SECRET=ganti_dengan_kunci_rahasia_jwt_minimal_32_karakter_acak_anda

# SMTP Email Notification (Untuk Registrasi Toko Baru & Reset Kata Sandi OTP)
# Jika dikosongkan, sistem berjalan dalam mode simulasi
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifikasi@domainanda.com
SMTP_PASS=app_password_email_anda
SMTP_FROM="POS IPAY Notifications <notifikasi@domainanda.com>"

# Integrasi PPOB Open API Gateway (https://ipay.my.id)
# Mode: 'sandbox' (simulasi lokal) atau 'live' (koneksi riil ke ipay.my.id)
IPAY_MODE=sandbox
IPAY_BASE_URL=https://ipay.my.id
IPAY_MERCHANT_ID=
IPAY_API_KEY=
IPAY_SECRET_KEY=

# Auto-Backup Database SQLite
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_FREQUENCY=daily
AUTO_BACKUP_RETENTION_DAYS=14
