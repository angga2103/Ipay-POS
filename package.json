{
  "name": "pos-ipay",
  "version": "1.0.0",
  "description": "Sistem Hybrid Web POS & Integrasi PPOB (ipay.my.id)",
  "main": "server/index.ts",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "tsx server/db/seed.ts",
    "postinstall": "node scripts/ensure-sqlite.cjs",
    "test": "tsx server/tests/run-tests.ts && tsx server/tests/test-konter-service.ts && tsx server/tests/test-customer-kasbon.ts && tsx server/tests/test-supplier-and-day1-sync.ts && tsx server/tests/test-backup-system.ts && tsx server/tests/test-multitenant.ts && tsx server/tests/test-retur-and-operational.ts"
  },
  "keywords": [
    "pos",
    "ppob",
    "minimarket",
    "accounting",
    "double-entry",
    "ipay"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15"
  }
}
